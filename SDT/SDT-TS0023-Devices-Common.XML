					<Extend domain="org.onem2m.common.moduleclass" entity="battery"/>
				</ModuleClass>
				<ModuleClass name="connectivity" minOccurs="0" maxOccurs="1">
					<Extend domain="org.onem2m.common.moduleclass" entity="connectivity"/>
				</ModuleClass>
				<ModuleClass name="periodicalReportConfig" minOccurs="0" maxOccurs="1">
					<Extend domain="org.onem2m.common.moduleclass" entity="periodicalReportConfig"/>
				</ModuleClass>
			</ModuleClasses>
		</DeviceClass>
		<DeviceClass id="deviceAudioReceiver">
